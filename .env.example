# Graph Algorithms Tracer - Backend Environment Variables
PORT=3000

# Google Gemini Vision API Key (Khuyên dùng, miễn phí tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-3.8-flash

# OpenAI Vision API Key (Tùy chọn)
# OPENAI_API_KEY=sk-proj-YourOpenAiApiKeyHere
# OPENAI_MODEL=gpt-4o-mini

# Cloud Database - Vercel KV / Upstash Redis (Tùy chọn: giúp localhost dùng chung Database với Vercel online)
# KV_REST_API_URL=https://your-upstash-redis-url.upstash.io
# KV_REST_API_TOKEN=your_upstash_redis_rest_token
